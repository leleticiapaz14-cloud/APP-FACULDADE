# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API). A chave pública (anon/publishable) pode ficar no app.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica
# Chave pública VAPID para notificações push (gerada com: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=
